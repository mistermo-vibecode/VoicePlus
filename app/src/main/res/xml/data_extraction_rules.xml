<?xml version="1.0" encoding="utf-8"?><!-- These are scoped cloud-backup and device-transfer rules for Android 12 and later. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include
            domain="database"
            path="." />
        <include
            domain="file"
            path="datastore/" />
        <include
            domain="file"
            path="bookCovers/" />
        <exclude
            domain="file"
            path="datastore/audiobookFolders" />
        <exclude
            domain="file"
            path="datastore/audiobookFolders.tmp" />
        <exclude
            domain="file"
            path="datastore/SingleFolderAudiobookFolders" />
        <exclude
            domain="file"
            path="datastore/SingleFolderAudiobookFolders.tmp" />
        <exclude
            domain="file"
            path="datastore/SingleFileAudiobookFolders" />
        <exclude
            domain="file"
            path="datastore/SingleFileAudiobookFolders.tmp" />
        <exclude
            domain="file"
            path="datastore/AuthorAudiobookFolders" />
        <exclude
            domain="file"
            path="datastore/AuthorAudiobookFolders.tmp" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot0" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot0.tmp" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot1" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot1.tmp" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot2" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot2.tmp" />
        <exclude
            domain="file"
            path="datastore/snapshotBackupState" />
        <exclude
            domain="file"
            path="datastore/snapshotBackupState.tmp" />
        <exclude
            domain="file"
            path="datastore/openListeningSession" />
        <exclude
            domain="file"
            path="datastore/openListeningSession.tmp" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="." />
        <include
            domain="file"
            path="datastore/" />
        <include
            domain="file"
            path="bookCovers/" />
        <exclude
            domain="file"
            path="datastore/audiobookFolders" />
        <exclude
            domain="file"
            path="datastore/audiobookFolders.tmp" />
        <exclude
            domain="file"
            path="datastore/SingleFolderAudiobookFolders" />
        <exclude
            domain="file"
            path="datastore/SingleFolderAudiobookFolders.tmp" />
        <exclude
            domain="file"
            path="datastore/SingleFileAudiobookFolders" />
        <exclude
            domain="file"
            path="datastore/SingleFileAudiobookFolders.tmp" />
        <exclude
            domain="file"
            path="datastore/AuthorAudiobookFolders" />
        <exclude
            domain="file"
            path="datastore/AuthorAudiobookFolders.tmp" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot0" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot0.tmp" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot1" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot1.tmp" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot2" />
        <exclude
            domain="file"
            path="datastore/librarySnapshot2.tmp" />
        <exclude
            domain="file"
            path="datastore/snapshotBackupState" />
        <exclude
            domain="file"
            path="datastore/snapshotBackupState.tmp" />
        <exclude
            domain="file"
            path="datastore/openListeningSession" />
        <exclude
            domain="file"
            path="datastore/openListeningSession.tmp" />
    </device-transfer>
</data-extraction-rules>
