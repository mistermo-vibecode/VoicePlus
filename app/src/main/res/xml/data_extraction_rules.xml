<?xml version="1.0" encoding="utf-8"?><!--
  Mirrors android:allowBackup="false" for Android 12+: nothing is cloud-backed-up or
  device-transferred by the OS. VoicePlus has its own explicit, user-controlled backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="external"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="external"
            path="." />
    </device-transfer>
</data-extraction-rules>
